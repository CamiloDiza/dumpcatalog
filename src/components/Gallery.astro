---
interface Props {
  photos: string[];
  name: string;
}

const { photos, name } = Astro.props;
---

{photos.length > 0 && (
  <section class="border-b border-zinc-800 px-6 py-16">
    <div class="mx-auto max-w-7xl">

      <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.4em] text-red-600">
          Media
        </p>

        <h2 class="mt-2 text-4xl font-black uppercase tracking-tight md:text-5xl">
          Galería
        </h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {photos.map((photo, index) => (
          <a
            href={photo}
            target="_blank"
            rel="noopener noreferrer"
            class="group block overflow-hidden bg-zinc-950"
          >
            <img
              src={photo}
              alt={`Foto ${index + 1} de ${name}`}
              loading="lazy"
              class="aspect-[3/4] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </a>
        ))}
      </div>

    </div>
  </section>
)}