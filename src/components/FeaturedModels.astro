---
import { getCollection } from 'astro:content';

const modelos = await getCollection('modelos', ({ data }) => data.featured);
---

<section class="border-b border-zinc-800 bg-black px-6 py-20">
  <div class="mx-auto max-w-7xl">

    <div class="mb-10 flex items-end justify-between gap-6">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.4em] text-red-600">
          Selection
        </p>

        <h2 class="mt-3 text-4xl font-black uppercase tracking-tighter md:text-6xl">
          Featured Sluts
        </h2>
      </div>

      <a
        href="/modelos"
        class="hidden text-xs font-black uppercase tracking-widest text-zinc-400 transition hover:text-red-500 sm:block"
      >
        Show Whores →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      {modelos.map((modelo) => (
        <a
          href={`/modelos/${modelo.data.slug}`}
          class="group overflow-hidden border border-zinc-800 bg-zinc-950 transition hover:border-red-600"
        >
          <div class="overflow-hidden">
            <img
              src={modelo.data.profileImage}
              alt={modelo.data.name}
              class="aspect-[3/4] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>

          <div class="p-5">

            <p class="text-xs font-black uppercase tracking-widest text-red-600">
              {modelo.data.shortPhrase}
            </p>

            <h3 class="mt-2 text-3xl font-black uppercase tracking-tight">
              {modelo.data.name}
            </h3>

            <div class="mt-4 flex flex-wrap gap-2">
              {modelo.data.tags.map((tag) => (
                <span class="text-xs font-bold uppercase text-zinc-500">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="mt-6 border-t border-zinc-800 pt-4 text-xs font-black uppercase tracking-widest text-white">
              Use bitch →
            </div>

          </div>
        </a>
      ))}

    </div>

  </div>
</section>