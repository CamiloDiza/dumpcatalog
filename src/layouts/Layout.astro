---
import '../styles/global.css';
import Header from '../components/Header.astro';

const { title = 'DumpCatalog' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="DumpCatalog - Catálogo de modelos"
    />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-black text-white">
    <Header />

    <slot />
  </body>
</html>