---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const modelos = await getCollection('modelos');
---

<Layout title="Modelos | DumpCatalog">
  <main class="min-h-screen bg-black text-white">

    <!-- INTRO -->
    <section class="border-b border-zinc-800 px-6 py-20">
      <div class="mx-auto max-w-7xl">

        <p class="text-xs font-black uppercase tracking-[0.4em] text-red-600">
          CumDumpCatalog / Catalog
        </p>

        <h1 class="mt-4 max-w-5xl text-6xl font-black uppercase leading-[0.9] tracking-[-0.05em] md:text-8xl">
          Whores<br />
          <span class="text-red-600">Available</span>
        </h1>

        <p class="mt-8 max-w-2xl border-l-4 border-red-600 pl-5 text-lg font-bold uppercase leading-relaxed text-zinc-400">
          Browse the catalog and view each dog's individual profile
        </p>

      </div>
    </section>

    <!-- CATÁLOGO -->
    <section class="px-6 py-16">
      <div class="mx-auto max-w-7xl">

        <div class="mb-8 flex items-center justify-between border-b border-zinc-800 pb-5">
          <p class="text-sm font-black uppercase tracking-widest text-zinc-400">
            {modelos.length} Whores in Catalog
          </p>

          <p class="hidden text-xs font-bold uppercase tracking-widest text-zinc-600 sm:block">
            Select a hole
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

          {modelos.map((modelo) => (
            <a
              href={`/modelos/${modelo.data.slug}`}
              class="group block overflow-hidden border border-zinc-800 bg-zinc-950 transition duration-300 hover:-translate-y-1 hover:border-red-600"
            >

              <!-- IMAGEN -->
              <div class="relative overflow-hidden">

                <img
                  src={modelo.data.profileImage}
                  alt={modelo.data.name}
                  class="aspect-[3/4] w-full object-cover transition duration-500 group-hover:scale-105"
                />

                {modelo.data.featured && (
                  <span class="absolute left-3 top-3 bg-red-600 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-white">
                    Featured
                  </span>
                )}

              </div>

              <!-- INFORMACIÓN -->
              <div class="p-5">

                <p class="text-[10px] font-black uppercase tracking-[0.25em] text-red-600">
                  {modelo.data.shortPhrase}
                </p>

                <h2 class="mt-2 text-3xl font-black uppercase leading-none tracking-tight">
                  {modelo.data.name}
                </h2>

                <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                  {modelo.data.tags.map((tag) => (
                    <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">
                      #{tag}
                    </span>
                  ))}
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-zinc-800 pt-4">

                  <span class="text-xs font-black uppercase tracking-widest">
                    Use this slut
                  </span>

                  <span class="text-lg text-red-600 transition-transform duration-300 group-hover:translate-x-1">
                    →
                  </span>

                </div>

              </div>

            </a>
          ))}

        </div>

      </div>
    </section>

  </main>
</Layout>